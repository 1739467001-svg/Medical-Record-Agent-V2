# AI 病历智能体 BFF · nginx 反向代理示例（TLS 终结 + 可选访问认证）
# 用法：替换 <域名> 与证书路径；cp 到 /etc/nginx/conf.d/medagent.conf && nginx -t && systemctl reload nginx
# 语音说明：浏览器要求麦克风权限页面为 HTTPS（或 localhost）——公网部署必须配置证书

server {
    listen 80;
    server_name <域名或IP>;
    return 301 https://$host$request_uri;   # 全量跳转 HTTPS
}

server {
    listen 443 ssl;
    http2 on;
    server_name <域名或IP>;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;   # Let's Encrypt / 院内 CA 证书
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 可选：基础认证层（试点期对外暴露时强烈建议；htpasswd -c /etc/nginx/medagent.htpasswd user1）
    # auth_basic "MedAgent";
    # auth_basic_user_file /etc/nginx/medagent.htpasswd;

    # 可选：IP 白名单（院内网段）
    # allow 10.0.0.0/8;
    # allow 192.168.0.0/16;
    # deny all;

    client_max_body_size 8m;      # 归档 MD 数据包上限余量
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:8801;   # 裸机 systemd 部署；docker 部署改为 http://medagent:8801
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
    }
}
